# ============================================================
# Mr ZF — security headers for Cloudflare Pages
# (This file only takes effect on Cloudflare Pages. On Vercel the
# same headers are configured in vercel.json. Safe to ignore.)
# ============================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
